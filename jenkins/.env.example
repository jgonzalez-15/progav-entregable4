# Copiar a jenkins/.env y completar. NO subir .env al repositorio.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambiar-esta-clave
# Usuario de QA que aprueba/rechaza el pase a producción
JENKINS_QA_ID=qa
JENKINS_QA_PASSWORD=cambiar-esta-clave-qa

# Repositorio a construir
REPO_URL=https://github.com/OWNER/piedra-papel-tijera-3d.git
REPO_BRANCH=main
# Solo si el repo es privado (token clásico con scope "repo" o fine-grained con Contents: Read)
GITHUB_USER=
GITHUB_TOKEN=

# URL pública de Jenkins (la de ngrok) para que los links de GitHub apunten bien
JENKINS_URL=http://localhost:8080/

# Túnel ngrok (perfil "tunnel"): token de https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Con dominio estático gratuito (recomendado, la URL no cambia entre reinicios):
# NGROK_EXTRA_ARGS=--url=https://tu-dominio.ngrok-free.app
NGROK_EXTRA_ARGS=
